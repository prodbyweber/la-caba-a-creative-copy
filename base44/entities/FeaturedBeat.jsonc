{
  "name": "FeaturedBeat",
  "type": "object",
  "properties": {
    "beat_id": {
      "type": "string",
      "description": "ID del beat de la biblioteca"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el beat se muestra en la landing"
    }
  },
  "required": [
    "beat_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}