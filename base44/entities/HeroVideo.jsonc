{
  "name": "HeroVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nombre interno del clip"
    },
    "video_url": {
      "type": "string",
      "description": "V\u00eddeo en loop (MP4 H.264 recomendado)"
    },
    "poster_url": {
      "type": "string",
      "description": "Imagen de respaldo mientras carga"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de rotaci\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si entra en la rotaci\u00f3n del hero"
    }
  },
  "required": [
    "video_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}