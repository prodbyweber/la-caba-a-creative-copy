{
  "name": "StartArtist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del artista"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen del artista para la tarjeta del carrusel"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}