{
  "name": "StartArtist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre art\u00edstico"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen horizontal del artista para la tarjeta del carrusel"
    },
    "spotify_url": {
      "type": "string",
      "description": "Enlace al perfil de Spotify del artista"
    },
    "credit": {
      "type": "string",
      "description": "Cr\u00e9dito o participaci\u00f3n en el proyecto (opcional)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}