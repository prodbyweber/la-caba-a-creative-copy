{
  "name": "ContactLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del contacto"
    },
    "email": {
      "type": "string",
      "description": "Email del contacto"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono en formato internacional (E.164)"
    },
    "message": {
      "type": "string",
      "description": "Resumen del proyecto enviado desde la home"
    },
    "status": {
      "type": "string",
      "enum": [
        "Nuevo",
        "Revisado",
        "Archivado"
      ],
      "default": "Nuevo",
      "description": "Estado de la solicitud"
    },
    "source": {
      "type": "string",
      "description": "Origen del formulario (proyecto-home)"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "G\u00e9neros seleccionados en el configurador"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Servicios seleccionados"
    },
    "stage": {
      "type": "string",
      "description": "Etapa del proyecto"
    },
    "country": {
      "type": "string",
      "description": "Pa\u00eds indicado por el usuario"
    },
    "demo_link": {
      "type": "string",
      "description": "Enlace a la demo"
    },
    "demo_file_uri": {
      "type": "string",
      "description": "URI privada del audio subido"
    },
    "demo_file_name": {
      "type": "string",
      "description": "Nombre del archivo subido"
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mood de la canci\u00f3n"
    },
    "references": {
      "type": "string",
      "description": "Referencias musicales"
    },
    "instructions": {
      "type": "string",
      "description": "Instrucciones personalizadas"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}