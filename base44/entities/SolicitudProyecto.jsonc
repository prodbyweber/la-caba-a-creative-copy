{
  "name": "SolicitudProyecto",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la persona"
    },
    "email": {
      "type": "string",
      "description": "Email de contacto"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp (opcional)"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "G\u00e9neros seleccionados"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Servicios que necesita"
    },
    "stage": {
      "type": "string",
      "description": "Etapa del proyecto"
    },
    "country": {
      "type": "string",
      "description": "Pa\u00eds indicado por el usuario"
    },
    "demo_link": {
      "type": "string",
      "description": "Enlace a la demo (Spotify, SoundCloud, YouTube, Drive...)"
    },
    "demo_file_uri": {
      "type": "string",
      "description": "URI privada del audio subido como demo"
    },
    "demo_file_name": {
      "type": "string",
      "description": "Nombre del archivo subido"
    },
    "creative_directions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Direcci\u00f3n creativa elegida"
    },
    "message": {
      "type": "string",
      "description": "Notas adicionales del usuario"
    },
    "status": {
      "type": "string",
      "enum": [
        "nueva",
        "revisada",
        "contactada",
        "cerrada"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "gray"
      ],
      "default": "nueva",
      "description": "Estado de la solicitud"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas internas"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}