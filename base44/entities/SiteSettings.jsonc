{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "seo_title": {
      "type": "string",
      "description": "T\u00edtulo SEO de la p\u00e1gina"
    },
    "seo_description": {
      "type": "string",
      "description": "Meta description"
    },
    "og_image_url": {
      "type": "string",
      "description": "Imagen al compartir la p\u00e1gina"
    },
    "brand_strip_title": {
      "type": "string",
      "description": "T\u00edtulo peque\u00f1o del carrusel de marcas"
    },
    "login_label": {
      "type": "string",
      "description": "Texto del bot\u00f3n de acceso"
    },
    "login_url": {
      "type": "string",
      "description": "Enlace del bot\u00f3n de acceso"
    },
    "request_label": {
      "type": "string",
      "description": "Texto del bot\u00f3n de solicitud de acceso"
    },
    "contact_email": {
      "type": "string",
      "description": "Email de contacto"
    },
    "city": {
      "type": "string",
      "description": "Ciudad"
    },
    "booking_label": {
      "type": "string",
      "description": "Texto del enlace de sesi\u00f3n de descubrimiento"
    },
    "booking_url": {
      "type": "string",
      "description": "Enlace de reserva de sesi\u00f3n de descubrimiento"
    },
    "social_instagram": {
      "type": "string",
      "description": "Instagram (vac\u00edo para ocultar)"
    },
    "social_tiktok": {
      "type": "string",
      "description": "TikTok (vac\u00edo para ocultar)"
    },
    "social_youtube": {
      "type": "string",
      "description": "YouTube (vac\u00edo para ocultar)"
    },
    "hero_media_url": {
      "type": "string",
      "description": "V\u00eddeo de fondo del hero (escritorio)"
    },
    "hero_media_mobile_url": {
      "type": "string",
      "description": "V\u00eddeo de fondo del hero (m\u00f3vil)"
    },
    "hero_poster_url": {
      "type": "string",
      "description": "Imagen fija del hero mientras carga el v\u00eddeo"
    },
    "hero_frames": {
      "type": "array",
      "description": "Cuadros del texto animado del hero: l\u00ednea fija, palabra fija, palabra que cambia y duraci\u00f3n",
      "items": {
        "type": "object",
        "properties": {
          "top": {
            "type": "string",
            "description": "Primera l\u00ednea fija del cuadro"
          },
          "prefix": {
            "type": "string",
            "description": "Palabra fija antes de la que cambia (ej: tu)"
          },
          "word": {
            "type": "string",
            "description": "Palabra que cambia, en naranja (ej: idea.)"
          },
          "hold_ms": {
            "type": "number",
            "description": "Tiempo en pantalla en milisegundos"
          },
          "order": {
            "type": "number",
            "description": "Orden del cuadro"
          }
        }
      }
    },
    "hero_final_top": {
      "type": "string",
      "description": "Cuadro final: l\u00ednea de arriba (ej: La)"
    },
    "hero_final_word": {
      "type": "string",
      "description": "Cuadro final: palabra grande en naranja (ej: Caba\u00f1a)"
    },
    "hero_final_hold_ms": {
      "type": "number",
      "description": "Cuadro final: tiempo en pantalla en milisegundos"
    },
    "hero_subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo que solo aparece en el cuadro final"
    },
    "hero_eyebrow": {
      "type": "string",
      "description": "Texto fijo encima del t\u00edtulo animado del hero"
    },
    "hero_lead": {
      "type": "string",
      "description": "Texto descriptivo bajo el t\u00edtulo animado, visible en los cuadros 1, 2 y 3"
    },
    "journey_media_url": {
      "type": "string",
      "description": "V\u00eddeo de fondo del recorrido por scroll"
    },
    "access_card_image_url": {
      "type": "string",
      "description": "Imagen de la tarjeta de acceso en el cierre"
    },
    "weber_name": {
      "type": "string",
      "description": "Nombre de Weber"
    },
    "weber_photo_url": {
      "type": "string",
      "description": "Foto de Weber"
    },
    "weber_bg_url": {
      "type": "string",
      "description": "Imagen de fondo de la secci\u00f3n de Weber"
    },
    "weber_line": {
      "type": "string",
      "description": "Una l\u00ednea de presentaci\u00f3n de Weber"
    },
    "journey_step1_title": {
      "type": "string"
    },
    "journey_step1_text": {
      "type": "string"
    },
    "journey_step2_title": {
      "type": "string"
    },
    "journey_step2_text": {
      "type": "string"
    },
    "journey_step3_title": {
      "type": "string"
    },
    "journey_step3_text": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}