{
  "name": "ProposalBlock",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Etiqueta corta (Qu\u00e9 es, Qu\u00e9 haces t\u00fa...)"
    },
    "text": {
      "type": "string",
      "description": "Texto del bloque"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden del bloque"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el bloque se muestra"
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}