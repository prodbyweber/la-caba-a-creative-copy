{
  "name": "FusionGenre",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del subg\u00e9nero"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n corta"
    },
    "accent": {
      "type": "string",
      "description": "Color de acento en hex"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}