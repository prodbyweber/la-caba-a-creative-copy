{
  "name": "RoadmapStep",
  "type": "object",
  "properties": {
    "num": {
      "type": "string",
      "description": "N\u00famero del paso (00, 01, 02...)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del paso"
    },
    "text": {
      "type": "string",
      "description": "Texto corto del paso"
    },
    "subline": {
      "type": "string",
      "description": "Segunda l\u00ednea (solo en el paso de apertura)"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palabras que rotan en el paso de apertura"
    },
    "cta_label": {
      "type": "string",
      "description": "Texto del bot\u00f3n del \u00faltimo paso"
    },
    "cta_link": {
      "type": "string",
      "description": "Destino del bot\u00f3n (ej: #comenzar)"
    },
    "is_intro": {
      "type": "boolean",
      "default": false,
      "description": "Si es la portada naranja del roadmap"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden del paso"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el paso se muestra"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}