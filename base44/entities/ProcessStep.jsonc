{
  "name": "ProcessStep",
  "type": "object",
  "properties": {
    "num": {
      "type": "string",
      "description": "N\u00famero grande del paso (01, 02...)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del paso"
    },
    "text": {
      "type": "string",
      "description": "Texto corto del paso"
    },
    "bullets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dos vi\u00f1etas explicativas (qu\u00e9 haces t\u00fa / qu\u00e9 hacemos nosotros)"
    },
    "color": {
      "type": "string",
      "description": "Color de fondo de la tarjeta en hex"
    },
    "panel": {
      "type": "string",
      "enum": [
        "genres",
        "mood",
        "mix",
        "checklist"
      ],
      "enumColors": [
        "orange",
        "purple",
        "blue",
        "green"
      ],
      "default": "genres",
      "description": "Mini panel animado de la tarjeta"
    },
    "video_url": {
      "type": "string",
      "description": "No se usa en la home actual (se conserva por compatibilidad)"
    },
    "image_url": {
      "type": "string",
      "description": "No se usa en la home actual (se conserva por compatibilidad)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden del paso"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el paso se muestra"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}