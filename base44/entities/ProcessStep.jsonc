{
  "name": "ProcessStep",
  "type": "object",
  "properties": {
    "num": {
      "type": "string",
      "description": "N\u00famero grande del paso (01, 02...)"
    },
    "icon": {
      "type": "string",
      "enum": [
        "sparkles",
        "disc",
        "target",
        "rocket",
        "music",
        "mic",
        "trending",
        "layers"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "orange",
        "pink",
        "gray",
        "yellow",
        "blue"
      ],
      "default": "sparkles",
      "description": "Icono del paso"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del paso"
    },
    "text": {
      "type": "string",
      "description": "Dos l\u00edneas de explicaci\u00f3n"
    },
    "video_url": {
      "type": "string",
      "description": "V\u00eddeo de fondo en loop (decorativo)"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen de fondo o p\u00f3ster"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden del paso"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el paso se muestra"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}