{
  "name": "FeaturedVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo del v\u00eddeo"
    },
    "youtube_url": {
      "type": "string",
      "description": "Enlace de YouTube"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Miniatura (si est\u00e1 vac\u00eda se usa la de YouTube)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Etiquetas o g\u00e9neros (ej: Afrobeats, Afrohouse)"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Si es el v\u00eddeo destacado grande"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el v\u00eddeo se muestra"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}