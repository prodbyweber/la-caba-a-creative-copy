{
  "name": "FullAccessProject",
  "type": "object",
  "properties": {
    "artist": {
      "type": "string",
      "description": "Artista"
    },
    "song": {
      "type": "string",
      "description": "T\u00edtulo de la canci\u00f3n"
    },
    "credit": {
      "type": "string",
      "description": "Cr\u00e9dito (Productor, Compositor...)"
    },
    "year": {
      "type": "string",
      "description": "A\u00f1o"
    },
    "youtube_url": {
      "type": "string",
      "description": "Enlace del videoclip"
    },
    "cover_url": {
      "type": "string",
      "description": "Fotograma o portada"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si el proyecto se muestra"
    }
  },
  "required": [
    "artist",
    "song"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}