{
  "name": "GenreCard",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identificador interno (latin_urban, afrobeats...)"
    },
    "name": {
      "type": "string",
      "description": "Nombre del g\u00e9nero en grande (LATIN URBAN...)"
    },
    "subgenres": {
      "type": "string",
      "description": "Subg\u00e9neros separados por \u00b7"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen de fondo o p\u00f3ster del v\u00eddeo"
    },
    "video_url": {
      "type": "string",
      "description": "V\u00eddeo de fondo en loop (solo decorativo)"
    },
    "tint": {
      "type": "string",
      "description": "Color de tinte de la tarjeta en hex"
    },
    "accent": {
      "type": "string",
      "description": "Color de acento para la cifra en hex"
    },
    "figure_value": {
      "type": "number",
      "description": "Cifra a animar (363.2, 5022, 15.1)"
    },
    "figure_prefix": {
      "type": "string",
      "description": "Prefijo de la cifra (ej: +, US$)"
    },
    "figure_suffix": {
      "type": "string",
      "description": "Sufijo de la cifra (ej: B, %)"
    },
    "figure_text": {
      "type": "string",
      "description": "Sustituye a la cifra cuando no es num\u00e9rica (ej: 1 de cada 4)"
    },
    "figure_label": {
      "type": "string",
      "description": "Qu\u00e9 mide la cifra"
    },
    "figure_note": {
      "type": "string",
      "description": "Periodo o comparaci\u00f3n de la cifra"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mini datos (m\u00e1ximo 3). Los vac\u00edos se ocultan."
    },
    "source": {
      "type": "string",
      "description": "Fuente del dato (ej: Luminate Midyear Report)"
    },
    "source_year": {
      "type": "string",
      "description": "A\u00f1o de la fuente (ej: 2026)"
    },
    "is_fusion": {
      "type": "boolean",
      "default": false,
      "description": "Si es una tarjeta peque\u00f1a de la fila Fusion"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}