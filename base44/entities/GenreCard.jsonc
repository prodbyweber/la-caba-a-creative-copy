{
  "name": "GenreCard",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identificador interno (latin_urban, afrobeats, pop...)"
    },
    "name": {
      "type": "string",
      "description": "Nombre del g\u00e9nero en grande"
    },
    "label": {
      "type": "string",
      "description": "Etiqueta peque\u00f1a en may\u00fasculas"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n corta bajo el mini t\u00edtulo SONIDO"
    },
    "video_url": {
      "type": "string",
      "description": "V\u00eddeo de fondo en loop (solo decorativo)"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen de fondo o p\u00f3ster del v\u00eddeo"
    },
    "tint": {
      "type": "string",
      "description": "Color de tinte de la tarjeta en hex"
    },
    "accent": {
      "type": "string",
      "description": "Color de acento en hex"
    },
    "global_data": {
      "type": "string",
      "description": "Dato global del g\u00e9nero (tendencia mundial). Si est\u00e1 vac\u00edo no se muestra."
    },
    "global_source": {
      "type": "string",
      "description": "Fuente del dato global"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}