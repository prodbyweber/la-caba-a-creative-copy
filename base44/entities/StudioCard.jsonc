{
  "name": "StudioCard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo de la tarjeta"
    },
    "video_url": {
      "type": "string",
      "description": "V\u00eddeo de previsualizaci\u00f3n de la sesi\u00f3n (loop, sin controles)"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen de fondo o p\u00f3ster"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}