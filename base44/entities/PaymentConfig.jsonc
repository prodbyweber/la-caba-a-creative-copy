{
  "name": "PaymentConfig",
  "type": "object",
  "properties": {
    "transfer_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Si el pago por transferencia bancaria est\u00e1 disponible"
    },
    "account_holder": {
      "type": "string",
      "description": "Titular de la cuenta bancaria"
    },
    "bank_name": {
      "type": "string",
      "description": "Nombre del banco"
    },
    "iban": {
      "type": "string",
      "description": "IBAN de la cuenta"
    },
    "bic_swift": {
      "type": "string",
      "description": "BIC / SWIFT de la cuenta"
    },
    "concept_instructions": {
      "type": "string",
      "description": "Instrucciones para el concepto de la transferencia"
    },
    "transfer_extra_instructions": {
      "type": "string",
      "description": "Instrucciones adicionales para la transferencia"
    },
    "cash_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Si el pago en efectivo est\u00e1 disponible"
    },
    "card_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Si el pago con tarjeta est\u00e1 disponible"
    },
    "card_payment_link": {
      "type": "string",
      "description": "URL de la plataforma de pago con tarjeta configurada por el admin"
    }
  },
  "required": []
}