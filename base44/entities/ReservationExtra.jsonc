{
  "name": "ReservationExtra",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del extra"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del extra"
    },
    "price": {
      "type": "number",
      "description": "Precio base del extra en euros"
    },
    "type": {
      "type": "string",
      "enum": [
        "simple",
        "beat",
        "hours_extra"
      ],
      "default": "simple",
      "description": "Tipo de extra: simple (precio fijo), beat (selecciona un beat del cat\u00e1logo), hours_extra (precio por hora, cantidad variable)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si el extra est\u00e1 disponible"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    }
  },
  "required": [
    "name",
    "price",
    "type"
  ]
}