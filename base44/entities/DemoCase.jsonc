{
  "name": "DemoCase",
  "type": "object",
  "properties": {
    "artist": {
      "type": "string",
      "description": "Nombre del artista"
    },
    "song": {
      "type": "string",
      "description": "Nombre de la canci\u00f3n"
    },
    "track_id": {
      "type": "string",
      "description": "ID del track del cat\u00e1logo al que corresponde (opcional)"
    },
    "genre": {
      "type": "string",
      "description": "G\u00e9nero musical"
    },
    "cover_url": {
      "type": "string",
      "description": "Portada cinematogr\u00e1fica"
    },
    "demo_audio_url": {
      "type": "string",
      "description": "Audio de la demo"
    },
    "master_audio_url": {
      "type": "string",
      "description": "Audio del master final"
    },
    "description": {
      "type": "string",
      "description": "Breve descripci\u00f3n del trabajo realizado"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Si la tarjeta se muestra"
    }
  },
  "required": [
    "artist"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}